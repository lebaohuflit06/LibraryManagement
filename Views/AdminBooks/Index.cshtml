@model List<Book>
@{
    ViewData["Title"] = "Quản lý sách";
    var q = ViewBag.Q as string;
}
<div class="toolbar">
    <h1>Quản lý sách</h1>
    <a class="btn" asp-action="Create">+ Thêm mã sách</a>
</div>
<form method="get" class="search wide">
    <input name="q" value="@q" placeholder="Tên sách, tác giả, NXB, thể loại (không cần gõ dấu)..." />
    <button class="btn" type="submit">Tìm</button>
</form>
<p class="muted">Có <b>@Model.Count</b> mã sách</p>
<div class="tbl-wrap">
    <table class="tbl">
        <thead>
            <tr><th>Mã sách</th><th>Tên sách</th><th>Tác giả</th><th>Thể loại</th><th>Giá</th><th>Đầu sách (còn / tổng)</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var b in Model)
            {
                <tr>
                    <td>@b.Id</td>
                    <td>@b.Title</td>
                    <td>@b.Author</td>
                    <td>@b.Category</td>
                    <td>@LibraryRules.Money(b.Price)</td>
                    <td>@b.Available / @b.Quantity</td>
                    <td>
                        <div class="row-actions">
                            <a class="btn btn-sm" asp-controller="AdminCopies" asp-action="Index" asp-route-bookId="@b.Id">Đầu sách</a>
                            <a class="btn btn-sm" asp-action="Edit" asp-route-id="@b.Id">Sửa</a>
                            <form asp-action="Delete" method="post" onsubmit="return confirm('Bạn chắc chắn muốn xóa mã sách này?');">
                                <input type="hidden" name="id" value="@b.Id" />
                                <button class="btn btn-sm btn-danger" type="submit">Xóa</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@model FeeWaiveViewModel
@{
    ViewData["Title"] = "Miễn phí";
    var fee = Model.Fee!;
}
<a class="back" asp-action="Index">← Quay lại phí &amp; bồi thường</a>
<div class="card form wide">
    <h1>Miễn phí</h1>
    <table class="meta">
        <tr><th>Độc giả</th><td>@fee.Card?.User?.FullName · @fee.Card?.CardNumber</td></tr>
        <tr><th>Loại phí</th><td>@Labels.FeeType(fee.Type)</td></tr>
        <tr><th>Nội dung</th><td>@fee.Description</td></tr>
        <tr><th>Số tiền được miễn</th><td><b>@LibraryRules.Money(fee.Amount)</b></td></tr>
    </table>
    <div class="alert">Miễn phí là thao tác của quản trị viên và được ghi vào nhật ký. Không thể hoàn tác.</div>
    <form asp-action="Waive" method="post">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="err"></div>

        <label asp-for="Reason"></label>
        <textarea asp-for="Reason" rows="3"></textarea>
        <span asp-validation-for="Reason" class="err"></span>

        <button class="btn full" type="submit" onclick="return confirm('Xác nhận miễn khoản phí này?');">Xác nhận miễn phí</button>
    </form>
</div>

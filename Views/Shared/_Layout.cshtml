<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Thư viện Sách Việt</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    @{
        var isAdmin = User.IsInRole("Admin");
        var isStaff = isAdmin || User.IsInRole("Librarian");
    }
    <header class="topbar">
        <div class="wrap bar">
            <a class="brand" asp-controller="Home" asp-action="Index"><span class="logo">📖</span> Thư viện Sách Việt</a>
            <nav>
                <a asp-controller="Home" asp-action="Index">Trang chủ</a>
                <a asp-controller="Books" asp-action="Index">Tra cứu sách</a>
                @if (isStaff)
                {
                    <div class="dd">
                        <span class="dd-t" tabindex="0">Quản lý ▾</span>
                        <div class="dd-m">
                            <a asp-controller="AdminBooks" asp-action="Index">Quản lý sách</a>
                            <a asp-controller="AdminTracking" asp-action="Index">Theo dõi tình trạng sách</a>
                            <a asp-controller="AdminCards" asp-action="Index">Quản lý thẻ</a>
                            <a asp-controller="AdminFees" asp-action="Index">Phí &amp; bồi thường</a>
                        </div>
                    </div>
                    <div class="dd">
                        <span class="dd-t" tabindex="0">Báo cáo ▾</span>
                        <div class="dd-m">
                            <a asp-controller="AdminReports" asp-action="LostDamaged">Sách mất / hỏng</a>
                            <a asp-controller="AdminDisposals" asp-action="Index">Thanh lý sách cũ / rác</a>
                        </div>
                    </div>
                    <div class="dd">
                        <span class="dd-t" tabindex="0">Hệ thống ▾</span>
                        <div class="dd-m">
                            <a asp-controller="AdminUsers" asp-action="Index">Tài khoản thành viên</a>
                            @if (isAdmin)
                            {
                                <a asp-controller="AdminRoles" asp-action="Index">Phân quyền</a>
                                <a asp-controller="AdminRoles" asp-action="Audit">Nhật ký thao tác</a>
                            }
                        </div>
                    </div>
                }
                else if (User.IsInRole("Member"))
                {
                    <a asp-controller="LibraryCard" asp-action="Index">Thẻ thư viện</a>
                    <a asp-controller="Loans" asp-action="Index">Sách của tôi</a>
                    <a asp-controller="Loans" asp-action="Fees">Phí của tôi</a>
                }
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="hello" asp-controller="Account" asp-action="Profile" title="Tài khoản của tôi">Xin chào, <b>@User.Identity.Name</b></a>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="inline">
                        <button class="btn btn-ghost" type="submit">Đăng xuất</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login">Đăng nhập</a>
                    <a class="btn" asp-controller="Account" asp-action="Register">Đăng ký</a>
                }
            </nav>
        </div>
    </header>
    <main class="wrap">
        @if (TempData["Msg"] is string msg)
        {
            <div class="alert ok">@msg</div>
        }
        @if (TempData["Err"] is string err)
        {
            <div class="alert bad">@err</div>
        }
        @RenderBody()
    </main>
    <footer class="foot">@DateTime.Now.Year Thư viện Sách Việt — Quản lý thư viện</footer>
</body>
</html>

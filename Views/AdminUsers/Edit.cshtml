@model AdminUserEditViewModel
@{ ViewData["Title"] = "Sửa tài khoản"; }
<a class="back" asp-action="Index">← Quay lại danh sách tài khoản</a>
<div class="card form">
    <h1>Sửa tài khoản</h1>
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="err"></div>

        <label asp-for="FullName"></label>
        <input asp-for="FullName" />
        <span asp-validation-for="FullName" class="err"></span>

        <label asp-for="Email"></label>
        <input asp-for="Email" type="email" />
        <span asp-validation-for="Email" class="err"></span>

        <label asp-for="NewPassword"></label>
        <input asp-for="NewPassword" />
        <span asp-validation-for="NewPassword" class="err"></span>

        <button class="btn full" type="submit">Lưu thay đổi</button>
    </form>
</div>

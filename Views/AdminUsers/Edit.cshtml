@model UserEditViewModel
@{ ViewData["Title"] = "Sửa tài khoản"; }
<a class="back" asp-action="Details" asp-route-id="@Model.Id">← Quay lại chi tiết tài khoản</a>
<div class="card form">
    <h1>Sửa tài khoản</h1>
    <p class="muted">Vai trò: <b>@AppRoles.Text(Model.Role)</b>
        @if (User.IsInRole("Admin")) { <text> · đổi vai trò tại <a asp-controller="AdminRoles" asp-action="Index">Phân quyền</a></text> }
    </p>
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="err"></div>

        <label asp-for="FullName"></label>
        <input asp-for="FullName" />
        <span asp-validation-for="FullName" class="err"></span>

        <label asp-for="Email"></label>
        <input asp-for="Email" type="email" />
        <span asp-validation-for="Email" class="err"></span>

        <button class="btn full" type="submit">Lưu thay đổi</button>
    </form>
</div>

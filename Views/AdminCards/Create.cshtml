@model AdminCardCreateViewModel
@{ ViewData["Title"] = "Cấp thẻ thư viện"; }
<a class="back" asp-action="Index">Quay lại danh sách thẻ</a>
<div class="card form">
    <h1>Cấp thẻ thư viện</h1>
    <p class="muted">Chỉ hiển thị thành viên đã có tài khoản nhưng chưa có thẻ. Thẻ có hiệu lực 1 năm.</p>
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="err"></div>
 
        <label asp-for="UserId"></label>
        <select asp-for="UserId" asp-items="Model.Users">
            <option value="">-- Chọn thành viên --</option>
        </select>
        <span asp-validation-for="UserId" class="err"></span>
 
        <label asp-for="DateOfBirth"></label>
        <input asp-for="DateOfBirth" type="date" />
        <span asp-validation-for="DateOfBirth" class="err"></span>
 
        <label asp-for="Phone"></label>
        <input asp-for="Phone" />
        <span asp-validation-for="Phone" class="err"></span>
 
        <label asp-for="IdNumber"></label>
        <input asp-for="IdNumber" />
        <span asp-validation-for="IdNumber" class="err"></span>
 
        <label asp-for="Address"></label>
        <input asp-for="Address" />
        <span asp-validation-for="Address" class="err"></span>
 
        <button class="btn full" type="submit">Cấp thẻ</button>
    </form>
</div>

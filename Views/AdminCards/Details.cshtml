@model LibraryCard
@{
    ViewData["Title"] = "Chi tiết thẻ " + Model.CardNumber;
    var unpaidFees = Model.Fees.Where(f => f.IsUnpaid).OrderBy(f => f.Id).ToList();
}
<a class="back" asp-action="Index">Quay lại danh sách thẻ</a>
<h1>Thẻ @Model.CardNumber</h1>
<table class="meta narrow">
    <tr><th>Họ tên</th><td>@Model.User?.FullName</td></tr>
    <tr><th>Email</th><td>@Model.User?.Email</td></tr>
    <tr><th>Ngày sinh</th><td>@Model.DateOfBirth.ToString("dd/MM/yyyy")</td></tr>
    <tr><th>Điện thoại</th><td>@Model.Phone</td></tr>
    <tr><th>CCCD</th><td>@Model.IdNumber</td></tr>
    <tr><th>Địa chỉ</th><td>@Model.Address</td></tr>
    <tr><th>Ngày cấp</th><td>@Model.IssuedAt.ToString("dd/MM/yyyy")</td></tr>
    <tr><th>Hết hạn</th><td>@Model.ExpiresAt.ToString("dd/MM/yyyy")</td></tr>
    <tr><th>Tình trạng sử dụng</th><td>
        @if (Model.IsActive) { <span class="badge b-ok">Sử dụng được</span> }
        else { <span class="badge b-bad">Không sử dụng</span> }
    </td></tr>
    <tr><th>Phí chưa thanh toán</th><td><b>@LibraryRules.Money(unpaidFees.Sum(f => f.Amount))</b> @if (unpaidFees.Count > 0) { <small>(@unpaidFees.Count khoản)</small> }</td></tr>
</table>
<p class="row-actions">
    <a class="btn btn-sm" asp-action="Edit" asp-route-id="@Model.Id">Sửa thẻ</a>
    <a class="btn btn-sm btn-ghost" asp-controller="AdminFees" asp-action="Create" asp-route-cardId="@Model.Id">+ Thêm khoản phí khác</a>
</p>

<h2 class="sec">Phí &amp; bồi thường</h2>
@if (Model.Fees.Count == 0)
{
    <div class="empty">Thẻ này chưa có khoản phí nào.</div>
}
else
{
    <div class="tbl-wrap">
        <table class="tbl">
            <thead><tr><th>Ngày</th><th>Loại</th><th>Nội dung</th><th class="num">Số tiền</th><th>Tình trạng</th><th></th></tr></thead>
            <tbody>
                @foreach (var f in Model.Fees.OrderByDescending(x => x.Id))
                {
                    <tr>
                        <td>@f.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td>@Labels.FeeType(f.Type)</td>
                        <td>@f.Description</td>
                        <td class="num"><b>@LibraryRules.Money(f.Amount)</b></td>
                        <td>
                            <span class="badge @Labels.FeeStatusCss(f.Status)">@Labels.FeeStatus(f.Status)</span>
                            @if (f.Status == FeeStatus.Paid) { <small>@f.ProcessedAt?.ToString("dd/MM/yyyy") · @Labels.Method(f.Method)</small> }
                            else if (f.Status == FeeStatus.Waived) { <small>@f.Note</small> }
                        </td>
                        <td>
                            <div class="row-actions">
                                @if (f.IsUnpaid)
                                {
                                    <a class="btn btn-sm" asp-controller="AdminFees" asp-action="Pay" asp-route-id="@f.Id">Thu tiền</a>
                                    if (User.IsInRole("Admin"))
                                    {
                                        <a class="btn btn-sm btn-ghost" asp-controller="AdminFees" asp-action="Waive" asp-route-id="@f.Id">Miễn</a>
                                    }
                                }
                                else if (f.Status == FeeStatus.Paid && f.ReceiptNo != null)
                                {
                                    <a class="btn btn-sm btn-ghost" asp-controller="AdminFees" asp-action="Receipt" asp-route-no="@f.ReceiptNo">Phiếu thu</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (unpaidFees.Count > 1)
    {
        <p><a class="btn btn-sm" asp-controller="AdminFees" asp-action="Pay" asp-route-id="@unpaidFees.First().Id" asp-route-all="true">Thu tất cả @unpaidFees.Count khoản (@LibraryRules.Money(unpaidFees.Sum(f => f.Amount)))</a></p>
    }
}
 
<h2 class="sec">Lịch sử mượn sách</h2>
@if (Model.Loans.Count == 0)
{
    <div class="empty">Thẻ này chưa mượn sách.</div>
}
@foreach (var l in Model.Loans.OrderByDescending(x => x.Id))
{
    <div class="card loan">
        <div class="toolbar">
            <h3 class="m0">
                Phiếu mượn #@l.Id
                @if (l.IsReturned) { <span class="badge b-ok">Đã trả</span> }
                else if (l.IsOverdue) { <span class="badge b-bad">Quá hạn</span> }
                else { <span class="badge b-warn">Đang mượn</span> }
            </h3>
            @if (!l.IsReturned)
            {
                <a class="btn btn-sm" asp-controller="Loans" asp-action="Return" asp-route-id="@l.Id">Xử lý trả sách</a>
            }
        </div>
        <p class="muted">
            Ngày mượn: @l.BorrowedAt.ToString("dd/MM/yyyy") · Hạn trả: @l.DueDate.ToString("dd/MM/yyyy")
            @if (l.IsReturned) { <text> · Ngày trả: @(l.ReturnedAt?.ToString("dd/MM/yyyy"))</text> }
        </p>
        <div class="tbl-wrap">
            <table class="tbl">
                <thead><tr><th>Sách</th><th>Số KS</th><th>Tình trạng khi trả</th><th>Ghi chú</th><th>Bồi thường</th><th></th></tr></thead>
                <tbody>
                @foreach (var it in l.Items)
                {
                    <tr>
                        <td>@it.Copy?.Book?.Title</td>
                        <td>@it.Copy?.ControlText</td>
                        <td>@(l.IsReturned ? LibraryRules.StatusText(it.ReturnStatus) : "Đang mượn")</td>
                        <td>@it.Note</td>
                        <td>
                            @if (it.Compensation > 0)
                            {
                                <b>@LibraryRules.Money(it.Compensation)</b>
                                <small>@(it.CompensationPaid ? "Đã xử lý" : "Chưa bồi thường")</small>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </td>
                        <td>
                            @{ var itemFee = Model.Fees.FirstOrDefault(f => f.LoanItemId == it.Id && f.IsUnpaid); }
                            @if (itemFee != null)
                            {
                                <a class="btn btn-sm" asp-controller="AdminFees" asp-action="Pay" asp-route-id="@itemFee.Id">Thu tiền</a>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

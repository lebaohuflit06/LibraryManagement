@model LiquidationReportViewModel
@{ ViewData["Title"] = "Báo cáo thanh lý sách năm " + Model.Year; }
<div class="toolbar">
    <h1>Báo cáo thanh lý sách năm @Model.Year</h1>
    <button class="btn btn-sm" type="button" onclick="window.print()">In báo cáo</button>
</div>
<form method="get" class="search wide">
    <input type="number" name="year" value="@Model.Year" min="2000" max="2100" />
    <button class="btn" type="submit">Xem năm này</button>
</form>

<h2 class="sec">Sách chờ thanh lý (đang mất / hỏng, rách, cũ)</h2>
<p class="muted">@Model.Candidates.Count cuốn · Tổng giá trị: <b>@LibraryRules.Money(Model.CandidateValue)</b>. Cuốn cũ / rách còn trên kệ: đặt tình trạng "Hỏng" trong mục Đầu sách để đưa vào danh sách này.</p>
@if (Model.Candidates.Count == 0)
{
    <div class="empty">Không có cuốn nào chờ thanh lý.</div>
}
else
{
    <div class="tbl-wrap">
        <table class="tbl">
            <thead><tr><th>Mã sách</th><th>Tên sách</th><th>Số KS</th><th>Tình trạng</th><th>Ngày ghi nhận</th><th>Giá</th><th>Ghi chú</th><th></th></tr></thead>
            <tbody>
            @foreach (var r in Model.Candidates)
            {
                <tr>
                    <td>@r.Copy.BookId</td>
                    <td>@r.Copy.Book?.Title</td>
                    <td>@r.Copy.ControlText</td>
                    <td><span class="badge @LibraryRules.StatusCss(r.Copy.Status)">@LibraryRules.StatusText(r.Copy.Status)</span></td>
                    <td>@(r.Copy.StatusChangedAt?.ToString("dd/MM/yyyy"))</td>
                    <td>@LibraryRules.Money(r.Copy.Book?.Price ?? 0)</td>
                    <td>@(r.Item?.Note ?? r.Copy.Note)</td>
                    <td>
                        <form asp-action="Liquidate" method="post" onsubmit="return confirm('Thanh lý cuốn sách này? Thao tác không thể hoàn tác.');">
                            <input type="hidden" name="id" value="@r.Copy.Id" />
                            <input type="hidden" name="year" value="@Model.Year" />
                            <button class="btn btn-sm btn-danger" type="submit">Thanh lý</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

<h2 class="sec">Đã thanh lý trong năm @Model.Year</h2>
<p class="muted">@Model.Liquidated.Count cuốn · Tổng giá trị: <b>@LibraryRules.Money(Model.LiquidatedValue)</b></p>
@if (Model.Liquidated.Count == 0)
{
    <div class="empty">Năm @Model.Year chưa thanh lý cuốn nào.</div>
}
else
{
    <div class="tbl-wrap">
        <table class="tbl">
            <thead><tr><th>#</th><th>Mã sách</th><th>Tên sách</th><th>Số KS</th><th>Ngày thanh lý</th><th>Giá</th><th>Ghi chú</th></tr></thead>
            <tbody>
            @{ var n = 0; }
            @foreach (var r in Model.Liquidated)
            {
                n++;
                <tr>
                    <td>@n</td>
                    <td>@r.Copy.BookId</td>
                    <td>@r.Copy.Book?.Title</td>
                    <td>@r.Copy.ControlText</td>
                    <td>@(r.Copy.StatusChangedAt?.ToString("dd/MM/yyyy"))</td>
                    <td>@LibraryRules.Money(r.Copy.Book?.Price ?? 0)</td>
                    <td>@(r.Item?.Note ?? r.Copy.Note)</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

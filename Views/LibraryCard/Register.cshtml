@model CardRegisterViewModel
@{ ViewData["Title"] = "Đăng ký thẻ thư viện"; }

<div class="card form">
    <h1>Đăng ký thẻ thư viện</h1>
    <p class="muted">Thẻ có hiệu lực 1 năm kể từ ngày cấp.</p>
    <form asp-action="Register" method="post">
        <div asp-validation-summary="ModelOnly" class="err"></div>

        <label asp-for="DateOfBirth"></label>
        <input asp-for="DateOfBirth" type="date" />
        <span asp-validation-for="DateOfBirth" class="err"></span>

        <label asp-for="Phone"></label>
        <input asp-for="Phone" />
        <span asp-validation-for="Phone" class="err"></span>

        <label asp-for="IdNumber"></label>
        <input asp-for="IdNumber" />
        <span asp-validation-for="IdNumber" class="err"></span>

        <label asp-for="Address"></label>
        <input asp-for="Address" />
        <span asp-validation-for="Address" class="err"></span>

        <button class="btn full" type="submit">Đăng ký thẻ</button>
    </form>
</div>

@model AuditViewModel
@{ ViewData["Title"] = "Nhật ký thao tác"; }
<a class="back" asp-action="Index">← Quay lại phân quyền</a>
<h1>Nhật ký thao tác</h1>
<p class="muted">Ghi lại việc tạo / sửa / khóa / xóa tài khoản, đặt lại mật khẩu, đổi vai trò, miễn phí và lập biên bản thanh lý.</p>
<form method="get" class="filters">
    <input name="q" value="@Model.Q" placeholder="Người thực hiện, thao tác, đối tượng..." />
    <button class="btn" type="submit">Tìm</button>
</form>
@if (Model.Logs.Count == 0)
{
    <div class="empty">Chưa có thao tác nào.</div>
}
else
{
    <div class="tbl-wrap">
        <table class="tbl">
            <thead><tr><th>Thời gian</th><th>Người thực hiện</th><th>Thao tác</th><th>Đối tượng</th><th>Chi tiết</th></tr></thead>
            <tbody>
                @foreach (var a in Model.Logs)
                {
                    <tr>
                        <td>@a.At.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@a.Actor</td>
                        <td><b>@a.Action</b></td>
                        <td>@a.Target</td>
                        <td>@a.Detail</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="(Model.Page, Model.TotalPages)" />
}

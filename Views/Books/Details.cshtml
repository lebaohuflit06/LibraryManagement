@model Book
@{ ViewData["Title"] = Model.Title; }

<a class="back" asp-action="Index">← Quay lại danh sách</a>
<div class="detail">
    <div class="cover big" style="--h:@(Model.Id * 47 % 360)"><span>@Model.Title</span></div>
    <div>
        <h1>@Model.Title</h1>
        <p class="muted">của <b>@Model.Author</b></p>
        <table class="meta">
            <tr><th>Thể loại</th><td>@Model.Category</td></tr>
            <tr><th>Nhà xuất bản</th><td>@Model.Publisher</td></tr>
            <tr><th>Năm xuất bản</th><td>@Model.Year</td></tr>
            <tr><th>Số trang</th><td>@Model.Pages</td></tr>
            <tr><th>Tình trạng</th><td>
                @if (Model.Available > 0) { <span class="stock in">Còn @Model.Available / @Model.Quantity cuốn</span> }
                    else
                    {

                        <span class="stock out">Hiện hết cuốn sách</span>
                    }
            </td></tr>
        </table>
        <h3>Giới thiệu</h3>
        <p>@Model.Description</p>
        @if (User.Identity?.IsAuthenticated != true)
        {
            <div class="alert">Bạn cần <a asp-controller="Account" asp-action="Login">đăng nhập</a> và có thẻ thư viện để mượn sách.</div>
        }
        else if (User.IsInRole("Member"))
        {
            if (Model.Available > 0)
            {
                <a class="btn" asp-controller="Loans" asp-action="Create" asp-route-bookId="@Model.Id">Mượn cuốn này</a>
                <p class="muted">Mỗi lần mượn tối đa @LibraryRules.MaxBooksPerLoan mã sách, trong @LibraryRules.LoanDays ngày. Trả sách xong mới được mượn tiếp.</p>
            }
            else
            {
                <div class="alert">Sách đã hết, vui lòng quay lại sau.</div>
            }
        }
    </div>
</div>

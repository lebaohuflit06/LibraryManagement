@model RegisterViewModel
@{ ViewData["Title"] = "Đăng ký tài khoản"; }

<div class="card form">
    <h1>Đăng ký tài khoản</h1>
    <form asp-action="Register" method="post">
        <div asp-validation-summary="ModelOnly" class="err"></div>
        <label asp-for="FullName"></label>
        <input asp-for="FullName" />
        <span asp-validation-for="FullName" class="err"></span>

        <label asp-for="Email"></label>
        <input asp-for="Email" type="email" />
        <span asp-validation-for="Email" class="err"></span>

        <label asp-for="Password"></label>
        <input asp-for="Password" />
        <span asp-validation-for="Password" class="err"></span>

        <label asp-for="ConfirmPassword"></label>
        <input asp-for="ConfirmPassword" />
        <span asp-validation-for="ConfirmPassword" class="err"></span>

        <button class="btn full" type="submit">Tạo tài khoản</button>
    </form>
    <p class="muted center">Đã có tài khoản? <a asp-action="Login">Đăng nhập</a></p>
</div>

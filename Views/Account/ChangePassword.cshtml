@model ChangePasswordViewModel
@{ ViewData["Title"] = "Đổi mật khẩu"; }

<div class="card form">
    <h1>Đổi mật khẩu</h1>
    @if (Model.Forced)
    {
        <div class="alert">Quản trị viên vừa đặt lại mật khẩu cho bạn. Vui lòng đổi sang mật khẩu của riêng bạn để tiếp tục sử dụng.</div>
    }
    <form asp-action="ChangePassword" method="post">
        <div asp-validation-summary="ModelOnly" class="err"></div>

        <label asp-for="CurrentPassword"></label>
        <input asp-for="CurrentPassword" autocomplete="current-password" />
        <span asp-validation-for="CurrentPassword" class="err"></span>

        <label asp-for="NewPassword"></label>
        <input asp-for="NewPassword" autocomplete="new-password" />
        <span asp-validation-for="NewPassword" class="err"></span>

        <label asp-for="ConfirmPassword"></label>
        <input asp-for="ConfirmPassword" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="err"></span>

        <button class="btn full" type="submit">Đổi mật khẩu</button>
    </form>
    @if (!Model.Forced)
    {
        <p class="muted center"><a asp-action="Profile">Quay lại tài khoản</a></p>
    }
</div>
